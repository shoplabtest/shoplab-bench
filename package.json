{
  "name": "shoplab-bench",
  "version": "1.0.0-dev",
  "private": true,
  "type": "module",
  "description": "ShopLab benchmark: manifest, answer keys, scorer, results",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
