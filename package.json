    "validate": "tsx src/cli.ts validate",
    "pin": "tsx src/cli.ts pin"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
